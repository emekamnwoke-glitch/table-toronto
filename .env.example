# Database
POSTGRES_USER=table_toronto
POSTGRES_PASSWORD=change_me
POSTGRES_DB=table_toronto
# "localhost" while the api-gateway and database scripts run on the host
# against Postgres's published port; switch to "postgres" (the compose
# service name) once the api-gateway itself runs inside docker-compose.yml
DATABASE_URL=postgresql://table_toronto:change_me@localhost:5432/table_toronto

# Auth
# Required, at least 32 chars; the api-gateway refuses to start otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Web app origin(s) allowed by CORS, comma-separated
CORS_ORIGIN=http://localhost:5173

# Mapping (OpenFreeMap needs no API key)
MAPLIBRE_TILE_URL=https://tiles.openfreemap.org/styles/liberty

# Routing (self-hosted Valhalla — see infra/valhalla/)
VALHALLA_URL=http://valhalla:8002

# Geocoding (self-hosted Nominatim — see docs/architecture/DECISIONS.md
# for the public-instance rate-limit note if not self-hosting yet)
NOMINATIM_URL=http://nominatim:8080

# Only needed for the popular-times target during ML training, not at
# app runtime
GOOGLE_PLACES_API_KEY=

# Mobile push (pragmatic exception — see DECISIONS.md)
EXPO_ACCESS_TOKEN=
